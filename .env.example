# Local application runtime. Never commit a populated .env file.
ENVIRONMENT=development
DATABASE_URL=postgresql+asyncpg://o_hive:local-development-only@localhost:5432/o_hive
FRONTEND_DIST=frontend/dist

# HTTPS URL created by the outbound-only Cloudflare Tunnel to the AWS EC2 model host.
AWS_INFERENCE_ENDPOINT=https://inference.example.com/v1/extract
AWS_INFERENCE_SHARED_SECRET=replace-with-a-long-random-secret
QWEN_MODEL=Qwen/Qwen3-VL-2B-Instruct
MODEL_DTYPE=float16

# Upload and AWS cost controls.
MAX_CARDS_PER_BATCH=20
MAX_FILE_BYTES=8388608
MAX_TOTAL_BYTES=67108864
MAX_IMAGE_PIXELS=24000000
MAX_DAILY_CARDS=100
INFERENCE_CONCURRENCY=2
INFERENCE_TIMEOUT_SECONDS=75
BATCH_CREATIONS_PER_MINUTE=10
CARD_REQUESTS_PER_MINUTE=30

# JSON arrays understood by pydantic-settings.
ALLOWED_HOSTS=["localhost","127.0.0.1"]
CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]
